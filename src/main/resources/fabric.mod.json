{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": ["ECJKim"],
  "environment": "client",
  "entrypoints": {
    "client": ["com.ecjkim.wayfarer.client.WayfarerClient"]
  },
  "license": "GPL-3.0-only",
  "contact": {
    "issues": "${issues}",
    "sources": "${source}"
  },
  "depends": {
    "fabricloader": "${fabric_loader_dependency}",
    "minecraft": "${minecraft_dependency}",
    "fabric-lifecycle-events-v1": "*",
    "fabric-key-binding-api-v1": "*",
    "fabric-resource-loader-v0": "*",
    "fabric-screen-api-v1": "*",
    "malilib": "*"
  },
  "mixins": ["wayfarer.mixins.json"],
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_releases": "${source}/releases",
        "modmenu.issues": "${issues}"
      },
      "update_checker": true
    }
  }
}
